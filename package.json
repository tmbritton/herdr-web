{
  "name": "herdr-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write frontend scripts/*.mjs package.json tsconfig.json eslint.config.mjs vitest.config.ts",
    "check": "prettier --check frontend scripts/*.mjs package.json tsconfig.json eslint.config.mjs vitest.config.ts && effect-tsgo tsc@7.0.2 --noEmit -p tsconfig.json && eslint frontend scripts/*.mjs vitest.config.ts",
    "test": "vitest run",
    "pretest:integration": "npm run build",
    "test:integration": "node scripts/integration.mjs"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@effect/vitest": "4.1.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.1",
    "ws": "^8.23.0"
  }
}
