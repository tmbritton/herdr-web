{
  "name": "herdr-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write frontend scripts/*.mjs package.json tsconfig.json eslint.config.mjs",
    "check": "prettier --check frontend scripts/*.mjs package.json tsconfig.json eslint.config.mjs && tsc --noEmit && eslint frontend scripts/*.mjs",
    "test": "node --test frontend/*.test.ts",
    "pretest:integration": "npm run build",
    "test:integration": "node scripts/integration.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "ws": "^8.23.0"
  }
}
